# ========================================
# DATABASE
# ========================================
DATABASE_URL=postgresql://user:password@localhost:5432/zayro_studios

# ========================================
# STRIPE
# ========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...

# ========================================
# NEXTAUTH
# ========================================
NEXTAUTH_SECRET=your-super-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# ========================================
# ADMIN AUTHENTICATION
# ========================================
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com,owner@example.com

# ========================================
# EMAIL / RESEND
# ========================================
RESEND_API_KEY=re_...
EMAIL_FROM=hello@zayro.studio
OWNER_EMAIL=owner@zayro.studio

# ========================================
# GOOGLE SERVICES
# ========================================
# Google Calendar
GOOGLE_CALENDAR_EMAIL=zayro-studios@iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Google Sheets
GOOGLE_SHEETS_EMAIL=zayro-studios@iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_SHEETS_ID=your-sheet-id
GOOGLE_SHEETS_SHEET_NAME=Bookings

# ========================================
# BUSINESS SETTINGS
# ========================================
BUSINESS_NAME=ZAYRO Studios
BUSINESS_ADDRESS=40 W 37th St, Suite 603, New York, NY 10018
BUSINESS_PHONE=+1-XXX-XXX-XXXX
BUSINESS_EMAIL=hello@zayro.studio
BUSINESS_HOURS_MONDAY=09:00-18:00
BUSINESS_HOURS_TUESDAY=09:00-18:00
BUSINESS_HOURS_WEDNESDAY=09:00-18:00
BUSINESS_HOURS_THURSDAY=09:00-18:00
BUSINESS_HOURS_FRIDAY=09:00-18:00
BUSINESS_HOURS_SATURDAY=10:00-16:00
BUSINESS_HOURS_SUNDAY=closed

# Booking settings
MIN_BOOKING_DURATION_MINUTES=30
MAX_BOOKING_DURATION_MINUTES=480
BOOKING_INCREMENT_MINUTES=30
BUFFER_BEFORE_BOOKING_MINUTES=15
BUFFER_AFTER_BOOKING_MINUTES=15
MIN_ADVANCE_NOTICE_HOURS=1
MAX_BOOKING_HORIZON_DAYS=90
TEMPORARY_HOLD_DURATION_MINUTES=15
TAX_RATE=0.08625

# ========================================
# ANALYTICS
# ========================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-...
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=...
NEXT_PUBLIC_META_PIXEL_ID=...

