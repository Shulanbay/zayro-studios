# ========================================
# DATABASE
# ========================================
DATABASE_URL=postgresql://user:password@localhost:5432/zayro_studios

# ========================================
# STRIPE
# ========================================
# Get these from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY must never be committed or exposed to browser
STRIPE_SECRET_KEY=sk_test_...
# Get webhook secret from https://dashboard.stripe.com/webhooks
# Must match the endpoint: /api/payment/webhook
STRIPE_WEBHOOK_SECRET=whsec_test_...

# ========================================
# NEXTAUTH
# ========================================
NEXTAUTH_SECRET=your-super-secret-key-here-change-in-production

# Signs customer "Manage Your Booking" links. Separate from NEXTAUTH_SECRET
# (admin auth) and STRIPE_SECRET_KEY (payments); there is no fallback — without
# it Manage Booking links are disabled. At least 32 random bytes, e.g.
#   openssl rand -base64 48
# Store the real value only in Vercel environment variables, never in the repo.
BOOKING_MANAGE_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ========================================
# ADMIN AUTHENTICATION
# ========================================
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com,owner@example.com

# ========================================
# EMAIL / RESEND
# ========================================
RESEND_API_KEY=re_...
EMAIL_FROM=hello@zayro.studio
OWNER_EMAIL=owner@zayro.studio

# ========================================
# GOOGLE CALENDAR + GOOGLE SHEETS (one service account for both)
# ========================================
# See GOOGLE_INTEGRATION_SETUP.md. Never commit real values; set them in
# Vercel → Settings → Environment Variables (Production).
#
# client_email from the service account JSON key
GOOGLE_CALENDAR_EMAIL=
# private_key from the service account JSON key. Paste it exactly as it
# appears in the JSON (with the literal \n sequences) — both that and real
# line breaks are accepted.
GOOGLE_CALENDAR_PRIVATE_KEY=
# Calendar ID of the dedicated "ZAYRO Studios Bookings" calendar
# (Google Calendar → Settings for that calendar → Integrate calendar)
GOOGLE_CALENDAR_ID=
# Spreadsheet ID: the part of the sheet URL between /d/ and /edit
GOOGLE_SHEETS_ID=
# Optional aliases (GOOGLE_CALENDAR_* take precedence when both are set):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ========================================
# BUSINESS SETTINGS
# ========================================
BUSINESS_NAME=ZAYRO Studios
BUSINESS_ADDRESS=40 W 37th St, Suite 603, New York, NY 10018
BUSINESS_PHONE=+1-XXX-XXX-XXXX
BUSINESS_EMAIL=hello@zayro.studio
BUSINESS_HOURS_MONDAY=09:00-18:00
BUSINESS_HOURS_TUESDAY=09:00-18:00
BUSINESS_HOURS_WEDNESDAY=09:00-18:00
BUSINESS_HOURS_THURSDAY=09:00-18:00
BUSINESS_HOURS_FRIDAY=09:00-18:00
BUSINESS_HOURS_SATURDAY=10:00-16:00
BUSINESS_HOURS_SUNDAY=closed

# Booking settings
MIN_BOOKING_DURATION_MINUTES=30
MAX_BOOKING_DURATION_MINUTES=480
BOOKING_INCREMENT_MINUTES=30
BUFFER_BEFORE_BOOKING_MINUTES=15
BUFFER_AFTER_BOOKING_MINUTES=15
MIN_ADVANCE_NOTICE_HOURS=1
MAX_BOOKING_HORIZON_DAYS=90
TEMPORARY_HOLD_DURATION_MINUTES=15
TAX_RATE=0.08625

# ========================================
# ANALYTICS AND ADVERTISING (all optional — see ANALYTICS_SETUP.md)
# ========================================
# Missing values simply disable that destination; the site and booking work
# the same. Vendor tags and server APIs run only on the production deployment
# (VERCEL_ENV=production) unless ANALYTICS_ALLOW_NON_PRODUCTION=1 is set for
# a *test* property/dataset. NEXT_PUBLIC_* values are public IDs (meant to
# reach the browser); every token/secret below is server-only.
# Never commit real values; set them in Vercel → Settings → Environment Variables.

# Master switch: vendor tags and server APIs stay OFF until this is 1
# (owner decision at rollout). First-party analytics works without it.
ANALYTICS_VENDORS_ENABLED=

# First-party analytics
# AES-GCM key for stored ad click IDs (≥ 32 random chars, e.g. openssl rand -base64 48).
# Without it click IDs are not stored at all (only "was present").
ANALYTICS_ENCRYPTION_SECRET=
# Secret for the delivery-retry / retention cron (GET /api/analytics/deliveries).
# Must be named CRON_SECRET: Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
# automatically and supports no other name. ≥ 16 random chars, server-only.
CRON_SECRET=
ANALYTICS_ATTRIBUTION_WINDOW_DAYS=
ANALYTICS_EXCLUDED_IPS=
ANALYTICS_ALLOW_NON_PRODUCTION=
ANALYTICS_RETENTION_EVENTS_MONTHS=
ANALYTICS_RETENTION_SESSIONS_MONTHS=
ANALYTICS_RETENTION_FAILED_DELIVERY_DAYS=
ANALYTICS_RETENTION_CONSENT_MONTHS=

# Google Tag Manager / GA4
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Server-only (Measurement Protocol). When set, GA4 conversions are sent server-side.
GA4_API_SECRET=
GA4_DEBUG=
# Legacy alias for NEXT_PUBLIC_GA4_MEASUREMENT_ID (still read, now consent-gated)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Google Ads (conversion ID and labels are not secret; Enhanced Conversions stay off)
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_BOOKING_CONVERSION_LABEL=
GOOGLE_ADS_TOUR_CONVERSION_LABEL=
GOOGLE_ADS_CONTACT_CONVERSION_LABEL=
# Legacy alias for GOOGLE_ADS_CONVERSION_ID
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=

# Reddit Pixel + Conversions API
NEXT_PUBLIC_REDDIT_PIXEL_ID=
REDDIT_PIXEL_ID=
REDDIT_CONVERSIONS_ACCESS_TOKEN=
REDDIT_TEST_MODE=

# Pinterest Tag + Conversions API
NEXT_PUBLIC_PINTEREST_TAG_ID=
PINTEREST_AD_ACCOUNT_ID=
PINTEREST_CONVERSIONS_ACCESS_TOKEN=
PINTEREST_TEST_MODE=

# TikTok Pixel + Events API
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_PIXEL_CODE=
TIKTOK_EVENTS_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# X (Twitter) Ads — Pixel (uwt.js) + Conversion API
# Base pixel ID from Ads Manager → Tools → Events Manager (e.g. o8z6j).
NEXT_PUBLIC_X_PIXEL_ID=
# Event IDs (format tw-<pixel>-<event>) for each conversion event created in Events Manager.
X_EVENT_ID_PAGE_VIEW=
X_EVENT_ID_VIEW_CONTENT=
X_EVENT_ID_LEAD=
X_EVENT_ID_CHECKOUT=
X_EVENT_ID_PURCHASE=
X_EVENT_ID_TOUR=
# Server-only: OAuth 1.0a credentials of an X developer app whose user has access to the ad account.
X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN_SECRET=
X_ADS_API_VERSION=

# Read-only analytics access (Marketing Analyst role, KPI dashboard only).
# Comma-separated emails. On first sign-in each gets a Marketing Analyst
# profile (audited). Disable or remove them in Admin → Team; the variable
# never re-enables a disabled profile.
ANALYTICS_VIEWER_EMAILS=

# ========================================
# VERCEL DEPLOYMENT
# ========================================
# Add deployment-specific env vars here
