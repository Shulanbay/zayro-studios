# ========================================
# DATABASE
# ========================================
DATABASE_URL=postgresql://user:password@localhost:5432/zayro_studios

# ========================================
# STRIPE
# ========================================
# Get these from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY must never be committed or exposed to browser
STRIPE_SECRET_KEY=sk_test_...
# Get webhook secret from https://dashboard.stripe.com/webhooks
# Must match the endpoint: /api/payment/webhook
STRIPE_WEBHOOK_SECRET=whsec_test_...

# ========================================
# NEXTAUTH
# ========================================
NEXTAUTH_SECRET=your-super-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# ========================================
# ADMIN AUTHENTICATION
# ========================================
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@example.com,owner@example.com

# ========================================
# EMAIL / RESEND
# ========================================
RESEND_API_KEY=re_...
EMAIL_FROM=hello@zayro.studio
OWNER_EMAIL=owner@zayro.studio

# ========================================
# GOOGLE CALENDAR + GOOGLE SHEETS (one service account for both)
# ========================================
# See GOOGLE_INTEGRATION_SETUP.md. Never commit real values; set them in
# Vercel → Settings → Environment Variables (Production).
#
# client_email from the service account JSON key
GOOGLE_CALENDAR_EMAIL=
# private_key from the service account JSON key. Paste it exactly as it
# appears in the JSON (with the literal \n sequences) — both that and real
# line breaks are accepted.
GOOGLE_CALENDAR_PRIVATE_KEY=
# Calendar ID of the dedicated "ZAYRO Studios Bookings" calendar
# (Google Calendar → Settings for that calendar → Integrate calendar)
GOOGLE_CALENDAR_ID=
# Spreadsheet ID: the part of the sheet URL between /d/ and /edit
GOOGLE_SHEETS_ID=
# Optional aliases (GOOGLE_CALENDAR_* take precedence when both are set):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ========================================
# BUSINESS SETTINGS
# ========================================
BUSINESS_NAME=ZAYRO Studios
BUSINESS_ADDRESS=40 W 37th St, Suite 603, New York, NY 10018
BUSINESS_PHONE=+1-XXX-XXX-XXXX
BUSINESS_EMAIL=hello@zayro.studio
BUSINESS_HOURS_MONDAY=09:00-18:00
BUSINESS_HOURS_TUESDAY=09:00-18:00
BUSINESS_HOURS_WEDNESDAY=09:00-18:00
BUSINESS_HOURS_THURSDAY=09:00-18:00
BUSINESS_HOURS_FRIDAY=09:00-18:00
BUSINESS_HOURS_SATURDAY=10:00-16:00
BUSINESS_HOURS_SUNDAY=closed

# Booking settings
MIN_BOOKING_DURATION_MINUTES=30
MAX_BOOKING_DURATION_MINUTES=480
BOOKING_INCREMENT_MINUTES=30
BUFFER_BEFORE_BOOKING_MINUTES=15
BUFFER_AFTER_BOOKING_MINUTES=15
MIN_ADVANCE_NOTICE_HOURS=1
MAX_BOOKING_HORIZON_DAYS=90
TEMPORARY_HOLD_DURATION_MINUTES=15
TAX_RATE=0.08625

# ========================================
# ANALYTICS
# ========================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-...
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=...
NEXT_PUBLIC_META_PIXEL_ID=...

# ========================================
# VERCEL DEPLOYMENT
# ========================================
# Add deployment-specific env vars here
